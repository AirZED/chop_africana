# Stripe test-mode keys — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Optional: only needed if you wire up `stripe listen` / a live webhook endpoint
# for the kitchen-dispatch route at /api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin panel (/admin) — required to sign in and manage products/analytics.
# Generate a strong secret with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too

# Seeds the first admin user (email + password, as "owner") into MongoDB the
# first time the login route runs against an empty admin_users collection.
# Only consulted while that collection is empty — safe to remove once you've
# logged in once.
ADMIN_SEED_EMAIL=you@example.com
ADMIN_SEED_PASSWORD=change-me-too

# Optional: order confirmation / status-update emails — https://resend.com/api-keys
# Without this set, emails are skipped (logged, not sent) rather than erroring.
RESEND_API_KEY=re_...
EMAIL_FROM="Chop Africana <orders@chopafricana.com>"
